default_platform(:ios)

platform :ios do
  desc "Build development IPA"
  lane :build_dev do
    # 用免费 Apple ID 生成开发证书
    cert(
      development: true,
      username: ENV["APPLE_ID"],
      team_id: ENV["TEAM_ID"],
      keychain_password: "temp1234"
    )

    # 生成开发 provisioning profile
    sigh(
      development: true,
      app_identifier: "com.aetherflow.app",
      username: ENV["APPLE_ID"],
      team_id: ENV["TEAM_ID"],
      force: true
    )

    # 编译 + 导出 IPA
    gym(
      project: "AetherFlow.xcodeproj",
      scheme: "AetherFlow",
      export_method: "development",
      output_directory: "build",
      output_name: "AetherFlow.ipa"
    )
  end
end
